# Node.js 24 LTS; use a direct PostgreSQL connection or a session pooler.
DATABASE_URL=postgresql://churchpay:churchpay@localhost:5432/churchpay
CHURCHPAY_DOMAINS=example

# Repeat each tenant setting with its upper-case slug; replace hyphens with
# underscores, preserving digits (example-1 becomes EXAMPLE_1).
# Existing non-letter-to-underscore suffixes remain a fallback if unambiguous.
CT_TOKEN_EXAMPLE=replace-with-a-dedicated-churchtools-token
PAYPAL_CLIENT_ID_EXAMPLE=replace-with-paypal-client-id
PAYPAL_CLIENT_SECRET_EXAMPLE=replace-with-paypal-client-secret
PAYPAL_MERCHANT_ID_EXAMPLE=replace-with-paypal-merchant-id
PAYPAL_ENV_EXAMPLE=sandbox
PAYPAL_WEBHOOK_ID_EXAMPLE=replace-with-paypal-webhook-id

# Required when using GET /api/reconcile instead of the CLI scheduler.
CRON_SECRET=replace-with-at-least-32-random-characters
